{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Three Layer Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "workflowId", "prototypeRevision", "prototypeHash", "contractId", "status", "layers", "runtimeEvidenceLevel", "evidenceRefs", "blockingReasons", "requiresFullGate", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "gateId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "prototypeRevision": {"type": "string", "minLength": 1},
    "prototypeHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contractId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED", "INCOMPLETE"]},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "runtime", "semantic"],
      "properties": {
        "static": {"enum": ["PASS", "FAIL", "MISSING"]},
        "runtime": {"enum": ["PASS", "FAIL", "INSUFFICIENT", "ENVIRONMENT_BLOCKED", "MISSING"]},
        "semantic": {"enum": ["PASS", "PASS_WITH_NONBLOCKING", "NEEDS_FIX", "BLOCKED", "MISSING"]}
      }
    },
    "runtimeEvidenceLevel": {"enum": ["STATIC_CONTRACT", "BROWSER_ADAPTER", "REAL_BROWSER", "MISSING"]},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "blockingReasons": {"type": "array", "items": {"type": "string"}},
    "requiresFullGate": {"const": true},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
