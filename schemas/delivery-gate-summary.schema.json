{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Gate Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "bundleId", "revision", "reviewRunId", "frozenCopy",
    "independentContext", "hashStable", "results", "openBlockingFindings", "finalizable"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "bundleId": {"type": "string"},
    "revision": {"type": "string"},
    "reviewRunId": {"type": "string"},
    "frozenCopy": {"type": "string"},
    "independentContext": {"const": true},
    "hashStable": {"const": true},
    "results": {
      "type": "object",
      "required": ["R0", "G1", "O1", "U1", "U2", "QA", "Q1"],
      "additionalProperties": {
        "enum": ["PASS", "PASS_WITH_NONBLOCKING", "NEEDS_FIX", "NOT_TRIGGERED", "NOT_APPLICABLE", "INCOMPLETE"]
      }
    },
    "openBlockingFindings": {"type": "integer", "minimum": 0},
    "finalizable": {"const": true}
  }
}
