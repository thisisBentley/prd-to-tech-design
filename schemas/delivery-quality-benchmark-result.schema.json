{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Quality Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "status", "productionEligible", "dataClassification", "sampleCount", "productionSampleCount", "metrics", "checks", "blockingCount", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "benchmarkId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "INSUFFICIENT_SAMPLES"]},
    "productionEligible": {"type": "boolean"},
    "dataClassification": {"enum": ["SYNTHETIC", "MIXED", "REAL"]},
    "sampleCount": {"type": "integer", "minimum": 0},
    "productionSampleCount": {"type": "integer", "minimum": 0},
    "metrics": {"type": "object", "additionalProperties": true},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "blockingCount": {"type": "integer", "minimum": 0},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
