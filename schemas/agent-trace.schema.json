{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Execution Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "traceId",
    "workflowId",
    "taskId",
    "contractId",
    "contractVersion",
    "role",
    "revision",
    "status",
    "contextPack",
    "toolCalls",
    "patches",
    "verification",
    "outcome",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "INCOMPLETE"
      ]
    },
    "contextPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callId",
          "name",
          "status",
          "startedAt",
          "completedAt"
        ],
        "properties": {
          "callId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "SKIPPED"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "observation": {
            "type": "string"
          }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patchId",
          "target",
          "scope",
          "status"
        ],
        "properties": {
          "patchId": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "beforeHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "afterHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "APPLIED",
              "REJECTED",
              "SKIPPED"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static",
        "runtime",
        "semantic"
      ],
      "properties": {
        "static": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "runtime": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "semantic": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultTaskStatus",
        "reviewVerdict",
        "resultRef"
      ],
      "properties": {
        "resultRef": {
          "type": "string",
          "minLength": 1
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        },
        "repairCount": {
          "type": "integer",
          "minimum": 0
        },
        "resultTaskStatus": {
          "enum": [
            "COMPLETED",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "reviewVerdict": {
          "enum": [
            "PASS",
            "FINDINGS",
            "REPAIR_PLAN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
