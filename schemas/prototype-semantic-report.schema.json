{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Semantic Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "workflowId", "prototypeRevision", "prototypeHash", "contractId", "status", "blockingCount", "findings", "checks", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reportId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "prototypeRevision": {"type": "string", "minLength": 1},
    "prototypeHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contractId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "PASS_WITH_NONBLOCKING", "NEEDS_FIX", "BLOCKED"]},
    "blockingCount": {"type": "integer", "minimum": 0},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "sourceAggregatePath": {"type": "string", "minLength": 1},
    "sourceAggregateHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
