{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Review Job Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "targetRevision", "modelPath", "modelSha256", "jobs", "generatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "targetRevision": {"type": "string", "minLength": 1},
    "modelPath": {"type": "string", "minLength": 1},
    "modelSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jobId", "path", "sha256", "layer", "inputUnitIds"],
        "properties": {
          "jobId": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "layer": {"enum": ["CONTRACT", "LOCAL", "EDGE", "GLOBAL"]},
          "inputUnitIds": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  }
}
