{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation Obligation Declarations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "targetRevision",
    "policyLockSha256",
    "declarations",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "policyLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligationId",
          "ruleId",
          "producerRole",
          "status",
          "artifact",
          "location",
          "evidenceRefs"
        ],
        "properties": {
          "obligationId": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "pattern": "^(R0|G1|O1|U1|U2|QA|Q1)\\.[A-Z0-9._-]+$"
          },
          "producerRole": {
            "type": "string",
            "minLength": 1
          },
          "producerTaskId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "DECLARED",
              "NOT_APPLICABLE"
            ]
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "NOT_APPLICABLE"
            }
          }
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      }
    }
  }
}
