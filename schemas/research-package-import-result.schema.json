{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Package Import Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "packagePath", "importedPath", "classification", "researchRecords", "decisionCards", "technicalGaps", "errors", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "packagePath": {"type": "string", "minLength": 1},
    "importedPath": {"type": "string", "minLength": 1},
    "classification": {"enum": ["SYNTHETIC", "MIXED", "REAL"]},
    "researchRecords": {"type": "integer", "minimum": 0},
    "decisionCards": {"type": "integer", "minimum": 0},
    "technicalGaps": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
