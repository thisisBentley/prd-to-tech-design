{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation Integrity Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "status", "mode", "taskSets", "policyPath", "counts", "invalidTaskIds", "tasks", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reportId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "mode": {"const": "STATIC_TASK_EVIDENCE_AUDIT"},
    "taskSets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policyPath": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "valid", "invalid"],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0},
        "valid": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      }
    },
    "invalidTaskIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["goldenTaskId", "taskVersion", "sampleId", "taskType", "capabilityMode", "status", "matchedScopeRules", "requiredArtifactTypes", "missingArtifactTypes", "missingEvidenceRefs", "errors"],
        "properties": {
          "goldenTaskId": {"type": "string", "minLength": 1},
          "taskVersion": {"type": "string", "minLength": 1},
          "sampleId": {"type": "string", "minLength": 1},
          "taskType": {"type": "string", "minLength": 1},
          "capabilityMode": {"type": "string", "minLength": 1},
          "status": {"enum": ["VALID", "INVALID"]},
          "matchedScopeRules": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "requiredArtifactTypes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "missingArtifactTypes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "missingEvidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
