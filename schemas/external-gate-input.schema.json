{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Gate Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "candidateRevision", "jiraKey", "gateType", "rawResult", "findings", "tool", "candidateArtifacts", "evidenceRefs", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "candidateRevision": {"type": "string", "minLength": 1},
    "jiraKey": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"},
    "gateType": {"enum": ["QA", "G1", "COMPOSITE", "OTHER"]},
    "rawResult": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "severity", "summary"],
        "properties": {
          "findingId": {"type": "string", "minLength": 1},
          "severity": {"enum": ["BLOCKING", "NON_BLOCKING", "INFO"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "version", "sourceCommit"],
      "properties": {
        "toolId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceCommit": {"type": "string", "minLength": 1}
      }
    },
    "candidateArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
