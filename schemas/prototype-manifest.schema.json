{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "workflowId",
    "prototypeRevision",
    "prototypePath",
    "prototypeHash",
    "elements",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "prototypeRevision": {"type": "string", "minLength": 1},
    "prototypePath": {"type": "string", "minLength": 1},
    "prototypeHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uiElementId", "frIds", "acIds", "visibleLabel", "states"],
        "properties": {
          "uiElementId": {"type": "string", "pattern": "^UI-[A-Za-z0-9_-]+$"},
          "frIds": {"type": "array", "items": {"type": "string", "pattern": "^FR-[0-9]{3}$"}, "minItems": 1},
          "acIds": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}, "minItems": 1},
          "visibleLabel": {"type": "string", "minLength": 1},
          "states": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "action": {"type": "string", "minLength": 1},
          "permissions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
