{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Runtime Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "executionMode", "runtimeEvidenceLevel", "prototypePath", "prototypeHash", "consoleErrors", "pageErrors", "requestFailures", "checks", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 2},
    "status": {"enum": ["PASS", "NEEDS_FIX", "INSUFFICIENT"]},
    "executionMode": {"type": "string", "minLength": 1},
    "runtimeEvidenceLevel": {"enum": ["STATIC_CONTRACT", "BROWSER_ADAPTER", "REAL_BROWSER"]},
    "browserVersion": {"type": "string"},
    "prototypePath": {"type": "string", "minLength": 1},
    "prototypeHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "consoleErrors": {"type": "array"},
    "pageErrors": {"type": "array"},
    "requestFailures": {"type": "array"},
    "screenshots": {"type": "array", "items": {"type": "string"}},
    "traces": {"type": "array", "items": {"type": "string"}},
    "interactionManifest": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
