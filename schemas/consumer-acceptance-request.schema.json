{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer Acceptance Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "caseId",
    "targetRevision",
    "artifactProfile",
    "caseClassification",
    "producer",
    "productManager",
    "architect",
    "artifacts",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "artifactProfile": {
      "enum": [
        "PRD_ONLY",
        "PRD_PLUS_PROTOTYPE",
        "EXISTING_PROTOTYPE_REVIEW",
        "EXTERNAL_UI_BOUNDARY"
      ]
    },
    "caseClassification": {
      "enum": [
        "FIXTURE",
        "REAL"
      ]
    },
    "producer": {
      "$ref": "#/$defs/actor"
    },
    "productManager": {
      "$ref": "#/$defs/actor"
    },
    "architect": {
      "$ref": "#/$defs/actor"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prd",
        "overview",
        "jira",
        "prdReviewResult",
        "decisionContract",
        "decisionReadiness",
        "sourceLock"
      ],
      "properties": {
        "prd": {
          "type": "string",
          "minLength": 1
        },
        "overview": {
          "type": "string",
          "minLength": 1
        },
        "prototype": {
          "type": "string"
        },
        "prototypeManifest": {
          "type": "string"
        },
        "runtimeEvidence": {
          "type": "string"
        },
        "prdReviewResult": {
          "type": "string",
          "minLength": 1
        },
        "decisionContract": {
          "type": "string",
          "minLength": 1
        },
        "decisionReadiness": {
          "type": "string",
          "minLength": 1
        },
        "sourceLock": {
          "type": "string",
          "minLength": 1
        },
        "jira": {
          "type": "string",
          "minLength": 1
        },
        "productManagerReview": {
          "type": "string",
          "minLength": 1
        },
        "architectReview": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "contextId"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "contextId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
