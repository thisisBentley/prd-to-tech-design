{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Optimizer Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "preflightId", "workflowId", "requirementId", "revision", "status", "authority", "prerequisites", "proposals", "evidenceGaps", "warnings", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "preflightId": {"type": "string", "pattern": "^OP-[a-f0-9]{16}$"},
    "workflowId": {"type": "string", "minLength": 1},
    "requirementId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^r[0-9]+$"},
    "status": {"enum": ["READY_FOR_HUMAN_CHANGE_SET", "BLOCKED"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "mayApply", "releaseEligible", "trainingEligible", "resultAuthority"],
      "properties": {
        "readOnly": {"const": true},
        "mayApply": {"const": false},
        "releaseEligible": {"const": false},
        "trainingEligible": {"const": false},
        "resultAuthority": {"const": "NONE"}
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prerequisiteId", "status", "observed", "expected", "sourceRefs"],
        "properties": {
          "prerequisiteId": {"enum": ["REAL_CLOSED_LOOP", "OBSERVER_COMPLETE", "HUMAN_ADJUDICATION", "OBSERVER_RECOMMENDATION", "REVISION_BINDING"]},
          "status": {"enum": ["PASS", "FAIL", "MISSING"]},
          "observed": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalId", "recommendationId", "priority", "owner", "action", "sourceRefs", "applyStatus"],
        "properties": {
          "proposalId": {"type": "string", "minLength": 1},
          "recommendationId": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "owner": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "applyStatus": {"const": "REQUIRES_HUMAN_CHANGE_SET"}
        }
      }
    },
    "evidenceGaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
