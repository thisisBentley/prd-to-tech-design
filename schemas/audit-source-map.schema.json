{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Source Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": {"const": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "path", "pathKind"],
        "properties": {
          "skillId": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "alternatePaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "pathKind": {"enum": ["REPO", "CODEX_SKILLS"]}
        }
      }
    }
  }
}
