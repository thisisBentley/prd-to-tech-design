{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Structured Result V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "taskStatus", "decisionType", "reviewVerdict", "evidence", "conclusions", "findings", "unknowns", "boundary"],
  "properties": {
    "schemaVersion": {"const": 2},
    "contractId": {"type": "string", "minLength": 1},
    "contractVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "taskId": {"type": "string", "minLength": 1},
    "taskStatus": {"enum": ["COMPLETED", "BLOCKED", "UNKNOWN"]},
    "decisionType": {"type": "string", "minLength": 1},
    "reviewVerdict": {"enum": ["PASS", "FINDINGS", "REPAIR_PLAN", "NOT_APPLICABLE"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "claim"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "conclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "severity", "title", "evidenceRefs"],
        "properties": {
          "findingId": {"type": "string", "minLength": 1},
          "severity": {"enum": ["BLOCKING", "NONBLOCKING", "INFO"]},
          "title": {"type": "string", "minLength": 1},
          "rootCauseId": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "closeCondition": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "boundary": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"reviewVerdict": {"const": "FINDINGS"}}},
      "then": {"properties": {"findings": {"minItems": 1}}}
    }
  ]
}
