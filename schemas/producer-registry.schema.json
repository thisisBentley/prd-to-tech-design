{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Producer Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "mode", "command", "requiredArtifacts"],
        "properties": {
          "kind": {"enum": ["prd", "prototype", "overview", "jira", "semantic-evidence"]},
          "mode": {"enum": ["deterministic", "provided", "semantic"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string"},
          "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
          "requiredArtifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "retries": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
