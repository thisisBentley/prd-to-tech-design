{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Task Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "taskId", "title", "objective", "changeRequested", "existingArtifactAvailable", "externalFindings", "localChangeScopes", "structuralChanges", "openBlockingDecisions", "unknownSignals", "evidenceRefs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "changeRequested": {"type": "boolean"},
    "existingArtifactAvailable": {"type": "boolean"},
    "externalFindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "localChangeScopes": {"type": "array", "items": {"enum": ["METADATA", "BUSINESS_RULES", "ACCEPTANCE", "CONTENT_PROJECTION", "COPY", "AUDIT_CONTRACT"]}},
    "structuralChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["newPage", "newRole", "newStateMachine", "newExternalBoundary", "newCoreEntity"],
      "properties": {
        "newPage": {"type": "boolean"},
        "newRole": {"type": "boolean"},
        "newStateMachine": {"type": "boolean"},
        "newExternalBoundary": {"type": "boolean"},
        "newCoreEntity": {"type": "boolean"}
      }
    },
    "openBlockingDecisions": {"type": "integer", "minimum": 0},
    "unknownSignals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
