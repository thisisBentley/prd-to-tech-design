{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Semantic Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "targetRevision", "artifactProfile", "source", "globalContracts", "units", "edges", "findings", "metrics", "generatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "targetRevision": {"type": "string", "minLength": 1},
    "artifactProfile": {"enum": ["PRD_ONLY", "PRD_PLUS_PROTOTYPE", "EXISTING_PROTOTYPE_REVIEW", "EXTERNAL_UI_BOUNDARY"]},
    "generationContractPath": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prdPath", "prdSha256"],
      "properties": {
        "prdPath": {"type": "string", "minLength": 1},
        "prdSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "prototypePath": {"type": "string"},
        "prototypeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifestPath": {"type": "string"},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "globalContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractId", "kind", "title", "statement", "sourceRef", "authority", "status"],
        "properties": {
          "contractId": {"type": "string", "pattern": "^GC-[A-Z0-9_-]+$"},
          "kind": {"enum": ["SCOPE", "GOALS", "PERMISSION", "STATE", "ENUM", "TERMINOLOGY", "CAPABILITY", "FEATURE_INDEX", "OTHER"]},
          "title": {"type": "string", "minLength": 1},
          "statement": {"type": "string"},
          "sourceRef": {"type": "string", "minLength": 1},
          "authority": {"enum": ["PRD", "PROTOTYPE", "EVIDENCE"]},
          "status": {"enum": ["ACTIVE", "PARTIAL", "CONFLICT"]}
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "kind", "title", "statement", "sourceRef", "authority", "frIds", "acIds", "dependencies", "sections", "fields", "content"],
        "properties": {
          "unitId": {"type": "string", "minLength": 1},
          "kind": {"enum": ["FEATURE_SLICE", "ACCEPTANCE_CRITERION", "INTERACTION_CONTRACT", "JOURNEY"]},
          "title": {"type": "string", "minLength": 1},
          "statement": {"type": "string"},
          "sourceRef": {"type": "string", "minLength": 1},
          "authority": {"enum": ["PRD", "PROTOTYPE", "EVIDENCE"]},
          "frIds": {"type": "array", "items": {"type": "string", "pattern": "^FR-[0-9]{3}$"}},
          "acIds": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "sections": {"type": "object", "additionalProperties": {"type": "string"}},
          "fields": {"type": "object", "additionalProperties": {"type": "string"}},
          "content": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "fromUnitId", "toUnitId", "relation", "status", "evidenceRefs"],
        "properties": {
          "edgeId": {"type": "string", "minLength": 1},
          "fromUnitId": {"type": "string", "minLength": 1},
          "toUnitId": {"type": "string", "minLength": 1},
          "relation": {"enum": ["DEPENDS_ON", "VERIFIED_BY", "VERIFIES", "BINDS_UI", "COVERS"]},
          "status": {"enum": ["ACTIVE", "UNRESOLVED"]},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globalContracts", "featureSlices", "acceptanceCriteria", "interactionContracts", "journeys", "edges"],
      "properties": {
        "globalContracts": {"type": "integer", "minimum": 0},
        "featureSlices": {"type": "integer", "minimum": 0},
        "acceptanceCriteria": {"type": "integer", "minimum": 0},
        "interactionContracts": {"type": "integer", "minimum": 0},
        "journeys": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0}
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  }
}
