{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Context Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "evidenceCoverage"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["READY", "PARTIAL", "UNAVAILABLE"]},
    "evidenceCoverage": {"enum": ["sufficient", "partial", "unavailable"]},
    "issueSnapshot": {"type": ["object", "null"]},
    "relatedWork": {"type": "array", "items": {"type": "object"}},
    "knowledgeEvidence": {"type": "array", "items": {"type": "object"}},
    "codeEvidence": {"type": "array", "items": {"type": "object"}},
    "gitEvidence": {"type": "array", "items": {"type": "object"}},
    "unavailableAdapters": {"type": "array", "items": {"type": "string"}}
  }
}
