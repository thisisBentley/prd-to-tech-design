{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolbox Rule Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "crosswalkId",
    "version",
    "sourceSkills",
    "mappings",
    "globalAudits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "crosswalkId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sourceSkills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skillId",
          "version",
          "sourceRef"
        ],
        "properties": {
          "skillId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mappingId",
          "policyRuleIds",
          "executorTypes",
          "skillId",
          "skillCheckIds",
          "requiredEvidence",
          "owner",
          "appliesToProfiles"
        ],
        "properties": {
          "mappingId": {
            "type": "string",
            "minLength": 1
          },
          "policyRuleIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(R0|G1|O1|U1|U2|QA|Q1)\\.[A-Z0-9._-]+$"
            }
          },
          "executorTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "DETERMINISTIC",
                "SEMANTIC",
                "HUMAN"
              ]
            }
          },
          "skillId": {
            "type": "string",
            "minLength": 1
          },
          "skillCheckIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "appliesToProfiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "globalAudits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "auditId",
          "auditType",
          "executorType",
          "skillId",
          "skillCheckIds",
          "requiredEvidence",
          "owner",
          "appliesToProfiles"
        ],
        "properties": {
          "auditId": {
            "type": "string",
            "minLength": 1
          },
          "auditType": {
            "enum": [
              "EDGE_REVIEW",
              "GLOBAL_INTEGRATION_REVIEW"
            ]
          },
          "executorType": {
            "enum": [
              "DETERMINISTIC",
              "SEMANTIC",
              "HUMAN"
            ]
          },
          "skillId": {
            "type": "string",
            "minLength": 1
          },
          "skillCheckIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "appliesToProfiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
