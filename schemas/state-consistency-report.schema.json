{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery State Consistency Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "revision",
    "status",
    "deliveryState",
    "orchestrationState",
    "readinessState",
    "sealState",
    "handoffState",
    "checks",
    "conflicts",
    "checkedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflowId": {"type": "string"},
    "revision": {"type": "string"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "deliveryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "revision", "bundleId"],
      "properties": {
        "path": {"type": "string"},
        "status": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "bundleId": {"type": ["string", "null"]}
      }
    },
    "orchestrationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "workflowId", "status", "currentStage"],
      "properties": {
        "path": {"type": "string"},
        "workflowId": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "currentStage": {"type": ["string", "null"]}
      }
    },
    "readinessState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "revision", "designReady"],
      "properties": {
        "path": {"type": "string"},
        "status": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "designReady": {"type": "boolean"}
      }
    },
    "sealState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateRevision", "finalRevision", "finalStatus", "frozenCopy"],
      "properties": {
        "candidateRevision": {"type": ["string", "null"]},
        "finalRevision": {"type": ["string", "null"]},
        "finalStatus": {"type": ["string", "null"]},
        "frozenCopy": {"type": ["string", "null"]}
      }
    },
    "handoffState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "handoffId", "revision", "workflowId", "phase", "openFindingCount"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "handoffId": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "workflowId": {"type": ["string", "null"]},
        "phase": {"type": ["string", "null"]},
        "openFindingCount": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "observed", "expected", "evidenceRefs"],
        "properties": {
          "checkId": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "observed": {},
          "expected": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "evidenceRefs"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
