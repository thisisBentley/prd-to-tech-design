{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Skill Finding Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "workflowId", "revision", "skillId", "findings", "metrics", "generatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "batchId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "skillId": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "title", "severity", "rootCauseId", "repairClass", "owner", "policyRuleIds", "evidenceRefs", "impact", "closeCondition", "externalSkillId", "externalFindingId"],
        "properties": {
          "findingId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["BLOCKING", "NON_BLOCKING", "INFO"]},
          "rootCauseId": {"type": "string", "minLength": 1},
          "repairClass": {"enum": ["SEMANTIC", "ARTIFACT_CONTRACT", "VISIBLE_INTERACTION", "RUNTIME", "EVIDENCE", "UNKNOWN"]},
          "owner": {"type": "string", "minLength": 1},
          "policyRuleIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "impact": {"type": "string", "minLength": 1},
          "closeCondition": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "minLength": 1},
          "externalSkillId": {"type": "string", "minLength": 1},
          "externalFindingId": {"type": "string", "minLength": 1}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "blocking", "nonBlocking", "info"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "blocking": {"type": "integer", "minimum": 0},
        "nonBlocking": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  }
}
