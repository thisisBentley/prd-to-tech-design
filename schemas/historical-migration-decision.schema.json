{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical Migration Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "queueId", "queueSha256", "reviewer", "decisions", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "queueId": {"type": "string", "minLength": 1},
    "queueSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Content hash of the review queue; timestamps are excluded."},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerId", "role", "independentFromAgent", "attestation"],
      "properties": {
        "reviewerId": {"type": "string", "minLength": 1},
        "role": {"const": "PRODUCT_OWNER"},
        "independentFromAgent": {"const": true},
        "attestation": {"type": "string", "minLength": 20}
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "decision", "reason", "evidenceRefs"],
        "properties": {
          "itemId": {"type": "string", "pattern": "^HMQ-[A-F0-9]{16}-[A-Z0-9_-]+$"},
          "decision": {"enum": ["APPROVE_MAPPING", "REJECT_MAPPING", "MARK_COMPLETED", "DEFER"]},
          "reason": {"type": "string", "minLength": 5},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "approvedFrIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FR-[0-9]{3}$"}}
        },
        "allOf": [
          {
            "if": {"properties": {"decision": {"const": "APPROVE_MAPPING"}}},
            "then": {"required": ["approvedFrIds"], "properties": {"approvedFrIds": {"minItems": 1}}}
          }
        ]
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
