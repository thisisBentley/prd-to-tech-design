{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "version",
    "title",
    "requiredGates",
    "executorTypes",
    "minimumExecutorsPerRule",
    "requireEdgeReview",
    "requireGlobalIntegrationReview",
    "blockingFindingPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "requiredGates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "R0",
          "G1",
          "O1",
          "U1",
          "U2",
          "QA",
          "Q1"
        ]
      }
    },
    "executorTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DETERMINISTIC",
          "SEMANTIC",
          "HUMAN"
        ]
      }
    },
    "minimumExecutorsPerRule": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "requireEdgeReview": {
      "type": "boolean"
    },
    "requireGlobalIntegrationReview": {
      "type": "boolean"
    },
    "blockingFindingPolicy": {
      "enum": [
        "BLOCK_ALL",
        "BLOCK_BLOCKING"
      ]
    },
    "focusRuleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(R0|G1|O1|U1|U2|QA|Q1)\\.[A-Z0-9._-]+$"
      }
    }
  }
}
