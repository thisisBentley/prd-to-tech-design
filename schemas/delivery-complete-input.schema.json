{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Complete Gate Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateId",
    "workflowId",
    "mode",
    "evidence",
    "replay"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gateId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "BASELINE",
        "PRODUCTION"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveryQualityExit",
        "finalGate",
        "pair",
        "consistency",
        "qualityBenchmark",
        "semanticReview",
        "recoveryReport",
        "handoff",
        "researchRecords",
        "stateConsistency",
        "semanticReviewInput",
        "qualityBenchmarkInput",
        "researchIndex"
      ],
      "properties": {
        "deliveryQualityExit": {
          "type": "string",
          "minLength": 1
        },
        "finalGate": {
          "type": "string",
          "minLength": 1
        },
        "pair": {
          "type": "string",
          "minLength": 1
        },
        "consistency": {
          "type": "string",
          "minLength": 1
        },
        "qualityBenchmark": {
          "type": "string",
          "minLength": 1
        },
        "semanticReview": {
          "type": "string",
          "minLength": 1
        },
        "recoveryReport": {
          "type": "string",
          "minLength": 1
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        },
        "stateConsistency": {
          "type": "string"
        },
        "researchRecords": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticReviewInput": {
          "type": "string",
          "minLength": 1
        },
        "qualityBenchmarkInput": {
          "type": "string",
          "minLength": 1
        },
        "researchIndex": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputManifestSha256",
        "replayRunSha256",
        "consistent"
      ],
      "properties": {
        "inputManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replayRunSha256": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "consistent": {
          "type": "boolean"
        }
      }
    }
  }
}
