{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "workflowId",
    "stage",
    "role",
    "objective",
    "inputs",
    "constraints",
    "expectedOutputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "discovery-producer",
        "delivery-intake-reviewer",
        "delivery-producer",
        "delivery-reviewer",
        "qa-red-team",
        "tech-prd-diagnostician",
        "tech-producer",
        "tech-reviewer",
        "product-acceptance-reviewer",
        "deterministic-gatekeeper",
        "decision-readiness-agent",
        "prd-producer",
        "prototype-producer",
        "overview-producer",
        "jira-projection-agent",
        "ui-boundary-agent",
        "prototype-contract-reviewer",
        "runtime-verifier",
        "final-package-reviewer",
        "finding-aggregator",
        "repair-planner",
        "prd-repair-agent",
        "prototype-repair-agent",
        "projection-repair-agent",
        "evidence-repair-agent",
        "semantic-consistency-reviewer"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expectedOutputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "reviewMode": {
      "enum": [
        "produce",
        "consumer-review",
        "independent-review",
        "gatekeeper"
      ]
    },
    "artifactProfile": {
      "enum": [
        "PRD_ONLY",
        "PRD_PLUS_PROTOTYPE",
        "EXISTING_PROTOTYPE_REVIEW",
        "EXTERNAL_UI_BOUNDARY",
        "UNKNOWN"
      ]
    },
    "readOnlyFrozenInputs": {
      "type": "boolean"
    },
    "writeScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "default": "noop",
      "enum": [
        "noop",
        "codex",
        "process"
      ],
      "description": "Execution adapter selected for this task. codex is a argv-backed invocation of codex exec; process is a generic local argv adapter."
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "description": "Isolation context assigned at spawn time when not supplied by the plan."
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Optional wall-clock execution timeout."
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "resultPath"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Executable argv. codex runtime should invoke codex exec with an explicit read-only or workspace sandbox and output path."
        },
        "resultPath": {
          "type": "string",
          "minLength": 1,
          "description": "Run-root relative structured result path."
        }
      }
    }
  }
}
