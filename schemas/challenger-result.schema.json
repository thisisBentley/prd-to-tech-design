{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Challenger Scenario Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "scenarioId", "status", "observedFailureSignal", "evidenceRefs", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "scenarioId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DETECTED", "MISSED", "INCOMPLETE", "ERROR"]},
    "observedFailureSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checkedAt": {"type": "string", "format": "date-time"},
    "error": {"type": "string", "minLength": 1},
    "transcript": {"type": "string"}
  }
}
