{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invariant Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "workflowId",
    "targetRevision",
    "registryPath",
    "registryHash",
    "reviewerRole",
    "independentContext",
    "decisions",
    "reviewedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "registryPath": {
      "type": "string",
      "minLength": 1
    },
    "registryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerRole": {
      "type": "string",
      "minLength": 1
    },
    "independentContext": {
      "const": true
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariantId",
          "decision",
          "targetStatus",
          "rationale",
          "evidenceRefs"
        ],
        "properties": {
          "invariantId": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9_-]+$"
          },
          "decision": {
            "enum": [
              "ACCEPT",
              "REJECT",
              "DEFER"
            ]
          },
          "targetStatus": {
            "enum": [
              "CANDIDATE",
              "ACTIVE",
              "LOCKED",
              "DEPRECATED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
