{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Contract Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "releaseVersion",
    "status",
    "sourceProfilePath",
    "sourceProfileSha256",
    "contracts",
    "contractHashes",
    "compiledAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "DEPRECATED"
      ]
    },
    "sourceProfilePath": {
      "type": "string",
      "minLength": 1
    },
    "sourceProfileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "contractHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "compiledAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
