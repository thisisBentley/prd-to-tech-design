{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Impact Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "workflowId",
    "targetRevision",
    "prdPath",
    "prdSha256",
    "status",
    "decisions",
    "findings",
    "metrics",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "graphId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "prdPath": {
      "type": "string",
      "minLength": 1
    },
    "prdSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decisionId",
          "selectedOptionId",
          "status",
          "affectedObjects",
          "expectedInvariant",
          "conflictingObjects",
          "verificationObjects",
          "evidenceRefs"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "minLength": 1
          },
          "selectedOptionId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "BLOCKED"
            ]
          },
          "affectedObjects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/objectRef"
            }
          },
          "expectedInvariant": {
            "type": "string",
            "minLength": 1
          },
          "conflictingObjects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/objectRef"
            }
          },
          "verificationObjects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/objectRef"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "decisionId",
          "severity",
          "code",
          "message",
          "evidenceRefs"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "decisionId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKING",
              "NON_BLOCKING"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closedDecisions",
        "passed",
        "blocked",
        "affectedObjects",
        "verificationObjects"
      ],
      "properties": {
        "closedDecisions": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "affectedObjects": {
          "type": "integer",
          "minimum": 0
        },
        "verificationObjects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "objectType",
        "artifact",
        "evidenceRefs"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "enum": [
            "GOAL",
            "FR",
            "BR",
            "IR",
            "STATE",
            "AC",
            "OVERVIEW",
            "DIAGRAM",
            "PROTOTYPE",
            "TEST_PLAN",
            "XMIND",
            "JIRA",
            "EVIDENCE",
            "OTHER"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
