{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change Set Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "routes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "policyId": {"type": "string", "minLength": 1},
    "routes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "repairTrack", "businessRevisionRequired", "ownerRole", "verificationChecks", "budget"],
        "properties": {
          "classification": {
            "enum": ["DECISION_GAP", "SOURCE_CONFLICT", "SPEC_MISSING", "ARTIFACT_DRIFT", "IMPLEMENTATION_RISK", "TEST_GAP", "EDITORIAL", "MECHANICAL"]
          },
          "repairTrack": {
            "enum": ["BUSINESS_REVISION", "ARTIFACT_SYNC", "TECH_SOLUTION", "TEST_PLAN", "MECHANICAL_REPAIR"]
          },
          "businessRevisionRequired": {"type": "boolean"},
          "ownerRole": {"type": "string", "minLength": 1},
          "verificationChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checkId", "kind", "description", "required"],
              "properties": {
                "checkId": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"}
              }
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxAffectedArtifacts", "maxFindings", "maxRepairRounds", "maxChangedLines"],
            "properties": {
              "maxAffectedArtifacts": {"type": "integer", "minimum": 1},
              "maxFindings": {"type": "integer", "minimum": 1},
              "maxRepairRounds": {"type": "integer", "minimum": 1},
              "maxChangedLines": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
