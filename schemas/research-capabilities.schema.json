{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "researchFirstRequired", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "researchFirstRequired": {"type": "boolean"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "configured", "status"],
        "properties": {
          "source": {"enum": ["JIRA", "MCP_CODE", "MCP_MAINLINE", "GIT"]},
          "configured": {"type": "boolean"},
          "status": {"enum": ["NOT_CONFIGURED", "CONFIGURED_AVAILABLE", "CONFIGURED_ERROR"]},
          "endpoint": {"type": "string"},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}},
          "error": {"type": "string"},
          "details": {"type": "object", "additionalProperties": true}
        }
      }
    }
  }
}
