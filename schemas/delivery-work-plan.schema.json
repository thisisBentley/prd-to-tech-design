{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Work Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "workflowId",
    "requirementId",
    "artifactProfile",
    "iteration",
    "tasks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "requirementId": {
      "type": "string"
    },
    "artifactProfile": {
      "enum": [
        "PRD_ONLY",
        "PRD_PLUS_PROTOTYPE",
        "EXISTING_PROTOTYPE_REVIEW",
        "EXTERNAL_UI_BOUNDARY",
        "UNKNOWN"
      ]
    },
    "iteration": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "role",
          "kind",
          "dependencies",
          "readScope",
          "writeScope",
          "expectedOutputs"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "producer",
              "reviewer",
              "repair",
              "verification",
              "gatekeeper",
              "decision"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "readScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "writeScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedOutputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PENDING",
              "READY",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "BLOCKED"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resultPath": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "runtimeRecordPath": {
            "type": "string",
            "minLength": 1
          },
          "reviewVerdict": {"type": "string"},
          "reviewBlockingCount": {"type": "integer", "minimum": 0},
          "repairRound": {"type": "integer", "minimum": 1},
          "recheckRound": {"type": "integer", "minimum": 1},
          "rootCauseId": {"type": "string"},
          "repairClass": {"type": "string"},
          "sourceBatch": {"type": "string"},
          "sourceRecheck": {"type": "string"},
          "returnedFromReview": {"type": "boolean"},
          "recheckFor": {"type": "string"},
          "failureClass": {"type": "string"},
          "decisionBlockPath": {"type": "string"}
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
