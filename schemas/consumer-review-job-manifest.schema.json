{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer Review Job Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestId", "workflowId", "caseId", "targetRevision",
    "caseClassification", "artifactProfile", "frozenInputs", "jobs", "status", "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "caseId": {"type": "string", "minLength": 1},
    "targetRevision": {"type": "string", "minLength": 1},
    "caseClassification": {"enum": ["FIXTURE", "REAL"]},
    "artifactProfile": {"type": "string", "minLength": 1},
    "frozenInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "contextId", "taskPath", "taskSha256", "reviewPlanPath", "reviewPlanSha256"],
        "properties": {
          "role": {"enum": ["product-manager-consumer", "architect-consumer"]},
          "contextId": {"type": "string", "minLength": 1},
          "taskPath": {"type": "string", "minLength": 1},
          "taskSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reviewPlanPath": {"type": "string", "minLength": 1},
          "reviewPlanSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "status": {"enum": ["READY", "BLOCKED"]},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
