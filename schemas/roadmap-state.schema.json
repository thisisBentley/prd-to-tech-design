{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roadmap State Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sources", "canonical", "checks", "status", "drift"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap", "changelog", "versionManifest", "datasetStatus"],
      "properties": {
        "roadmap": {"$ref": "#/$defs/source"},
        "changelog": {"$ref": "#/$defs/source"},
        "versionManifest": {"$ref": "#/$defs/source"},
        "datasetStatus": {"$ref": "#/$defs/source"}
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmapIteration", "changelogIteration", "skillVersion", "baselineId", "currentMilestone", "roadmapMilestone", "datasetMilestone", "trainingBaselineStatus"],
      "properties": {
        "roadmapIteration": {"type": "integer", "minimum": 1},
        "changelogIteration": {"type": "integer", "minimum": 1},
        "skillVersion": {"type": "string", "minLength": 1},
        "baselineId": {"type": "string", "minLength": 1},
        "currentMilestone": {"type": "string", "minLength": 1},
        "roadmapMilestone": {"type": "string", "minLength": 1},
        "datasetMilestone": {"type": "string", "minLength": 1},
        "trainingBaselineStatus": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "observed", "expected"],
        "properties": {
          "checkId": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "observed": {},
          "expected": {}
        }
      }
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "drift": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
