{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Quality Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "generatedAt",
    "dataClassification",
    "samples",
    "thresholds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "benchmarkId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataClassification": {
      "enum": [
        "SYNTHETIC",
        "MIXED",
        "REAL"
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumSamples",
        "maximumSamples",
        "minimumFindingRecall",
        "maximumFalsePositiveRate",
        "minimumReplayConsistency"
      ],
      "properties": {
        "minimumSamples": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "maximumSamples": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "minimumFindingRecall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumFalsePositiveRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumReplayConsistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleId",
          "profile",
          "caseTypes",
          "productionEligible",
          "durationSeconds",
          "expectedFindingIds",
          "detectedFindingIds",
          "repairRounds",
          "repeatedRootCauseCount",
          "escalationCount",
          "decisionCount",
          "traceability",
          "pairStatus",
          "unresolvedDelta",
          "staleOverview",
          "runtimeConsoleErrors",
          "replayHash",
          "replayMatches",
          "openEscalationCount",
          "openDecisionCount"
        ],
        "properties": {
          "sampleId": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "PRD_ONLY",
              "PRD_PLUS_PROTOTYPE",
              "EXISTING_PROTOTYPE_REVIEW",
              "EXTERNAL_UI_BOUNDARY"
            ]
          },
          "caseTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "SIMPLE_PRD_ONLY",
                "COMPLEX_PERMISSION_STATE",
                "PRD_PROTOTYPE",
                "PROTOTYPE_SEMANTIC_DELETE",
                "EXISTING_CAPABILITY_TERMINOLOGY",
                "MULTI_ROUND_REPAIR",
                "DECISION_ESCALATION"
              ]
            }
          },
          "productionEligible": {
            "type": "boolean"
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "expectedFindingIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "detectedFindingIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "repairRounds": {
            "type": "integer",
            "minimum": 0
          },
          "repeatedRootCauseCount": {
            "type": "integer",
            "minimum": 0
          },
          "escalationCount": {
            "type": "integer",
            "minimum": 0
          },
          "decisionCount": {
            "type": "integer",
            "minimum": 0
          },
          "traceability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frTotal",
              "frCovered",
              "acTotal",
              "acCovered"
            ],
            "properties": {
              "frTotal": {
                "type": "integer",
                "minimum": 0
              },
              "frCovered": {
                "type": "integer",
                "minimum": 0
              },
              "acTotal": {
                "type": "integer",
                "minimum": 0
              },
              "acCovered": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "pairStatus": {
            "enum": [
              "SYNCED",
              "RESYNC_REQUIRED",
              "NOT_APPLICABLE"
            ]
          },
          "unresolvedDelta": {
            "type": "integer",
            "minimum": 0
          },
          "staleOverview": {
            "type": "integer",
            "minimum": 0
          },
          "runtimeConsoleErrors": {
            "type": "integer",
            "minimum": 0
          },
          "replayHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "replayMatches": {
            "type": "boolean"
          },
          "openEscalationCount": {
            "type": "integer",
            "minimum": 0
          },
          "openDecisionCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
