{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-Artifact Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "result", "checks", "findings", "blockingFindings", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactType": {"const": "cross-artifact-preflight"},
    "result": {"enum": ["PASS", "NEEDS_FIX"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "evidenceRefs"],
        "properties": {
          "checkId": {"type": "string"},
          "status": {"enum": ["passed", "failed"]},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "ruleId", "severity", "requirementRefs", "observed", "expectedBasis", "closeCondition"],
        "properties": {
          "findingId": {"type": "string"},
          "ruleId": {"type": "string"},
          "severity": {"const": "blocking"},
          "requirementRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "observed": {"type": "string"},
          "expectedBasis": {"type": "string"},
          "closeCondition": {"type": "string"}
        }
      }
    },
    "blockingFindings": {"type": "integer", "minimum": 0},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
