{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Decision Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "workflowId", "reviewerRole", "businessScenario", "currentFacts", "ambiguity", "options", "recommendation", "defaultAndRisk", "owner", "closeCondition", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "decisionId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "reviewerRole": {"type": "string"},
    "businessScenario": {"type": "string", "minLength": 1},
    "currentFacts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "ambiguity": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "label", "result", "impact", "reversibility"],
        "properties": {
          "optionId": {"type": "string"},
          "label": {"type": "string"},
          "result": {"type": "string"},
          "impact": {"type": "string"},
          "reversibility": {"enum": ["reversible", "irreversible", "unknown"]}
        }
      }
    },
    "recommendation": {"type": "string", "minLength": 1},
    "defaultAndRisk": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "closeCondition": {"type": "string"},
    "status": {"enum": ["open", "confirmed", "closed"]},
    "selectedOptionId": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
