{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Native Delivery State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requirement",
    "runRoot",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requirement": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "runRoot": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "phase1": {
      "$ref": "#/$defs/phase1"
    },
    "phase2": {
      "$ref": "#/$defs/phase2"
    }
  },
  "$defs": {
    "phase1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "status"
      ],
      "properties": {
        "skill": {
          "const": "discovery"
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "CONCEPT_DRAFT",
            "CONCEPT_READY"
          ]
        },
        "briefPath": {
          "type": "string"
        },
        "contextSnapshotPath": {
          "type": "string"
        },
        "capabilityIdeationPath": {
          "type": "string"
        },
        "capabilityMatrixPath": {
          "type": "string"
        },
        "openDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "phase2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "status",
        "inputSources",
        "evidenceCoverage"
      ],
      "properties": {
        "skill": {
          "const": "delivery"
        },
        "status": {
          "enum": [
            "DESIGN_DRAFTING",
            "CANDIDATE_SEALING",
            "CANDIDATE_SEALED",
            "INDEPENDENT_GATES_RUNNING",
            "RETURN_FOR_REPAIR",
            "FINAL_GATE_OUTPUT_WRITING",
            "DESIGN_READY"
          ]
        },
        "inputSources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "adapterUsage": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidenceCoverage": {
          "enum": [
            "sufficient",
            "partial",
            "unavailable"
          ]
        },
        "bundleId": {
          "type": "string"
        },
        "gates": {
          "type": "object",
          "properties": {
            "R0": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            },
            "G1": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            },
            "O1": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            },
            "U1": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            },
            "U2": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            },
            "QA": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            },
            "Q1": {
              "enum": [
                "PASS",
                "PASS_WITH_NONBLOCKING",
                "NEEDS_FIX",
                "NOT_TRIGGERED",
                "NOT_APPLICABLE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "R0",
            "G1",
            "O1",
            "U1",
            "U2",
            "QA",
            "Q1"
          ],
          "additionalProperties": false
        },
        "candidateRevision": {
          "type": "string"
        },
        "finalRevision": {
          "type": "string"
        },
        "candidateSeal": {
          "type": "string"
        },
        "finalSeal": {
          "type": "string"
        },
        "gateOutputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewRunId": {
          "type": "string"
        },
        "retryRound": {
          "type": "integer",
          "minimum": 0
        },
        "reviewEvidence": {
          "type": "string"
        }
      }
    }
  }
}
