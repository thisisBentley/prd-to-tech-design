{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Mode Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "workflowId", "taskId", "mode", "status", "reasons", "signals", "policyPath", "policyHash", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "decisionId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "mode": {"enum": ["DIAGNOSIS_ONLY", "TARGETED_REVISION", "FULL_DELIVERY", "ESCALATE"]},
    "status": {"enum": ["CLASSIFIED", "ESCALATE"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "signals": {"type": "object", "additionalProperties": true},
    "policyPath": {"type": "string", "minLength": 1},
    "policyHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
