{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deltaId", "workflowId", "fromPrototypeRevision", "toPrototypeRevision", "changeType", "requiresPrdReconciliation", "changes", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "deltaId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "fromPrototypeRevision": {"type": "string", "minLength": 1},
    "toPrototypeRevision": {"type": "string", "minLength": 1},
    "changeType": {"enum": ["COSMETIC", "SEMANTIC"]},
    "requiresPrdReconciliation": {"type": "boolean"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "uiElementId", "reason", "evidenceRefs"],
        "properties": {
          "action": {"enum": ["ADD", "MODIFY", "DELETE", "MOVE", "COPY_CHANGE"]},
          "uiElementId": {"type": "string", "pattern": "^UI-[A-Za-z0-9_-]+$"},
          "linkedFeatureIds": {"type": "array", "items": {"type": "string", "pattern": "^FR-[0-9]{3}$"}},
          "linkedAcIds": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3}$"}},
          "reason": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
