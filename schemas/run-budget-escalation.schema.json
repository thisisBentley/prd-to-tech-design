{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Budget Escalation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "escalationId", "workflowId", "revision", "status", "code", "message", "metric", "limit", "observed", "evidenceRefs", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "escalationId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN", "CLOSED"]},
    "code": {"enum": ["BUDGET_EXCEEDED", "JOB_TIMEOUT", "REPAIR_BUDGET_EXCEEDED"]},
    "message": {"type": "string", "minLength": 1},
    "metric": {"type": "string", "minLength": 1},
    "limit": {"type": "number", "minimum": 0},
    "observed": {"type": "number", "minimum": 0},
    "jobId": {"type": "string", "minLength": 1},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
