{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repair Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repairPlanId",
    "workflowId",
    "targetRevision",
    "sourceBatch",
    "tasks",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repairPlanId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "sourceBatch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "READY",
        "NO_REPAIR",
        "INCOMPLETE"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "changeSetId",
          "rootCauseId",
          "role",
          "repairClass",
          "classification",
          "businessRevisionRequired",
          "affectedArtifacts",
          "closeConditions",
          "verificationPlan",
          "regressionTests",
          "budget",
          "dependencies",
          "status"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "rootCauseId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "repairClass": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affectedArtifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "closeConditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "regressionTests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "PENDING",
              "READY",
              "RUNNING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "changeSetId": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "DECISION_GAP",
              "SOURCE_CONFLICT",
              "SPEC_MISSING",
              "ARTIFACT_DRIFT",
              "IMPLEMENTATION_RISK",
              "TEST_GAP",
              "EDITORIAL",
              "MECHANICAL"
            ]
          },
          "businessRevisionRequired": {
            "type": "boolean"
          },
          "verificationPlan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checkId",
                "kind",
                "description",
                "required"
              ],
              "properties": {
                "checkId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
