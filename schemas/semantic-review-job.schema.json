{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Review Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "workflowId", "targetRevision", "layer", "objective", "inputUnitIds", "context", "reviewQuestions", "outputContract", "generatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "targetRevision": {"type": "string", "minLength": 1},
    "layer": {"enum": ["CONTRACT", "LOCAL", "EDGE", "GLOBAL"]},
    "objective": {"type": "string", "minLength": 1},
    "inputUnitIds": {"type": "array", "items": {"type": "string"}},
    "context": {"type": "object", "additionalProperties": true},
    "reviewQuestions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "verdicts", "rule"],
      "properties": {
        "schema": {"const": "review-result.schema.json"},
        "verdicts": {"type": "array", "items": {"enum": ["ACCEPTED", "ACCEPTED_WITH_ACTIONS", "RETURNED", "BLOCKED", "INCOMPLETE"]}},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  }
}
