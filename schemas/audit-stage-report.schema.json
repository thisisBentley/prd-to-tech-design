{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Audit Stage Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "revision",
    "status",
    "orderChecked",
    "candidateSealPath",
    "candidateSealSha256",
    "artifactRoot",
    "auditPlanPath",
    "auditSummaryPath",
    "auditRunnerReportPath",
    "plan",
    "runner",
    "errors",
    "startedAt",
    "finishedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["AUDIT_PASS", "AUDIT_BLOCKED", "AUDIT_ORDER_VIOLATION"]},
    "orderChecked": {"const": true},
    "candidateSealPath": {"type": "string", "minLength": 1},
    "candidateSealSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "artifactRoot": {"type": ["string", "null"]},
    "auditPlanPath": {"type": "string", "minLength": 1},
    "auditSummaryPath": {"type": "string", "minLength": 1},
    "auditRunnerReportPath": {"type": "string", "minLength": 1},
    "plan": {"type": ["object", "null"]},
    "runner": {"type": ["object", "null"]},
    "evidenceResolutionPath": {"type": ["string", "null"]},
    "evidenceResolution": {"type": ["object", "null"]},
    "evidenceResolutionRun": {"type": ["object", "null"]},
    "telemetryPath": {"type": ["string", "null"]},
    "telemetry": {"type": ["object", "null"]},
    "escalationPath": {"type": ["string", "null"]},
    "sourceDriftPath": {"type": ["string", "null"]},
    "sourceDrift": {"type": ["object", "null"]},
    "sourceDriftRun": {"type": ["object", "null"]},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"}
  }
}
