{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Package Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "artifactProfile",
    "revision",
    "artifacts",
    "gates",
    "technicalGapsPath",
    "createdAt",
    "artifactQualityPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "artifactProfile": {
      "enum": [
        "PRD_ONLY",
        "PRD_PLUS_PROTOTYPE",
        "EXISTING_PROTOTYPE_REVIEW",
        "EXTERNAL_UI_BOUNDARY"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "PRD",
              "PROTOTYPE",
              "OVERVIEW",
              "JIRA_DESCRIPTION"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": true
    },
    "technicalGapsPath": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactQualityPath": {
      "type": "string",
      "minLength": 1
    },
    "prototypeManifestPath": {
      "type": "string",
      "minLength": 1
    },
    "researchQueryResult": {
      "type": "string",
      "minLength": 1
    },
    "generationContract": {
      "type": "string",
      "minLength": 1
    },
    "semanticModel": {
      "type": "string",
      "minLength": 1
    },
    "semanticIntegrationReview": {
      "type": "string",
      "minLength": 1
    },
    "semanticReviewJobs": {
      "type": "string",
      "minLength": 1
    },
    "policyLockPath": {
      "type": "string",
      "minLength": 1
    },
    "policyLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generationObligationsPath": {
      "type": "string",
      "minLength": 1
    },
    "generationObligationsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "obligationDeclarationsPath": {
      "type": "string",
      "minLength": 1
    },
    "obligationDeclarationsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "obligationDeclarationsValidationPath": {
      "type": "string",
      "minLength": 1
    },
    "runtimeEvidencePath": {
      "type": "string",
      "minLength": 1
    },
    "hardeningSummaryPath": {
      "type": "string",
      "minLength": 1
    },
    "hardeningSummarySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hardening": {
      "type": "object",
      "additionalProperties": true
    },
    "costRevisionLedgerPath": {
      "type": "string",
      "minLength": 1
    },
    "costRevisionLedgerSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "costRevisionLedgerStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT"
      ]
    },
    "costRevisionLedgerMetrics": {
      "type": "object",
      "additionalProperties": true
    },
    "deliveryOperatingProcedurePath": {
      "type": "string",
      "minLength": 1
    },
    "deliveryOperatingProcedureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deliveryOperatingProcedureStatus": {
      "enum": [
        "READY",
        "READY_WITH_ACTIONS",
        "BLOCKED"
      ]
    },
    "deliveryOperatingProcedureValidationPath": {
      "type": "string",
      "minLength": 1
    },
    "projectEpisodePath": {
      "type": "string",
      "minLength": 1
    },
    "projectEpisodeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectEpisodeStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "projectEpisodeTrainingEligible": {
      "const": false
    },
    "projectEpisodeValidationPath": {
      "type": "string",
      "minLength": 1
    },
    "collaborationSurfacePath": {
      "type": "string",
      "minLength": 1
    },
    "collaborationSurfaceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "collaborationSurfaceStatus": {
      "enum": [
        "READY",
        "ACTION_REQUIRED",
        "BLOCKED"
      ]
    },
    "collaborationSurfaceNextActionCount": {
      "type": "integer",
      "minimum": 0
    },
    "collaborationSurfaceValidationPath": {
      "type": "string",
      "minLength": 1
    },
    "rehearsalCorpusPath": {
      "type": "string",
      "minLength": 1
    },
    "rehearsalCorpusSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rehearsalCorpusStatus": {
      "enum": [
        "READY",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "rehearsalCorpusScenarioCount": {
      "type": "integer",
      "minimum": 0
    },
    "rehearsalCorpusValidationPath": {
      "type": "string",
      "minLength": 1
    }
  }
}
