{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Review Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewPlanId", "reviewRunId", "workflowId", "reviewerRole", "targetHandoffId", "targetRevision", "questions", "evidenceTargets", "counterexamples", "selectedChecks", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reviewPlanId": {"type": "string", "minLength": 1},
    "reviewRunId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "reviewerRole": {"enum": ["delivery-intake-reviewer", "delivery-reviewer", "qa-red-team", "tech-prd-diagnostician", "tech-reviewer", "product-acceptance-reviewer", "deterministic-gatekeeper"]},
    "targetHandoffId": {"type": "string", "minLength": 1},
    "targetRevision": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidenceTargets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "selectedChecks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
