{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Operating Procedure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "procedureId", "workflowId", "requirementId", "artifactProfile",
    "revision", "status", "goalContract", "subgoals", "guardrails", "toolAuthority",
    "contextPolicy", "stateContract", "stopPolicy", "revisionPolicy", "exitCriteria",
    "provenance", "metrics", "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "procedureId": {"type": "string", "minLength": 1},
    "workflowId": {"type": "string", "minLength": 1},
    "requirementId": {"type": "string", "minLength": 1},
    "artifactProfile": {"enum": ["PRD_ONLY", "PRD_PLUS_PROTOTYPE", "EXISTING_PROTOTYPE_REVIEW", "EXTERNAL_UI_BOUNDARY"]},
    "revision": {"type": "string", "pattern": "^r[0-9]+$"},
    "status": {"enum": ["READY", "READY_WITH_ACTIONS", "BLOCKED"]},
    "goalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveText", "objectiveSource", "requirementTypes", "generationContractStatus", "sourcePath", "sourceSha256"],
      "properties": {
        "objectiveText": {"type": "string", "minLength": 1},
        "objectiveSource": {"enum": ["EXPLICIT", "REQUIREMENT_TITLE", "UNAVAILABLE"]},
        "requirementTypes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generationContractStatus": {"enum": ["READY", "READY_WITH_ACTIONS", "BLOCKED", "SKIPPED"]},
        "generationContractPath": {"type": ["string", "null"]},
        "generationContractSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "sourcePath": {"type": "string", "minLength": 1},
        "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "subgoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subgoalId", "ownerRole", "kind", "dependencies", "expectedOutputs", "required", "status"],
        "properties": {
          "subgoalId": {"type": "string", "minLength": 1},
          "ownerRole": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expectedOutputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required": {"type": "boolean"},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyLockPath", "policyLockSha256", "applicableRules", "excludedRules", "obligationsTotal", "obligationsOpen", "sourcePackStatus"],
      "properties": {
        "policyLockPath": {"type": "string", "minLength": 1},
        "policyLockSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "applicableRules": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "excludedRules": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "obligationsPath": {"type": ["string", "null"]},
        "obligationsSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "obligationsTotal": {"type": "integer", "minimum": 0},
        "obligationsOpen": {"type": "integer", "minimum": 0},
        "sourcePackStatus": {"enum": ["PASS", "PARTIAL", "BLOCKED", "SKIPPED"]}
      }
    },
    "toolAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyPath", "policySha256", "defaultTaskDomain", "routes"],
      "properties": {
        "policyPath": {"type": "string", "minLength": 1},
        "policySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "defaultTaskDomain": {"type": "string", "minLength": 1},
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["routeId", "executionModes", "intents", "toolId", "toolDomain", "allowedTaskDomains", "allowedOperations", "writeAuthority", "sourcePackRefs"]
          }
        }
      }
    },
    "contextPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxContextFiles", "allowedSourceClasses", "sourcePackPath", "sourcePackSha256", "readScopeCount"],
      "properties": {
        "maxContextFiles": {"type": "integer", "minimum": 1},
        "allowedSourceClasses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sourcePackPath": {"type": ["string", "null"]},
        "sourcePackSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "readScopeCount": {"type": "integer", "minimum": 0}
      }
    },
    "stateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planPath", "planSha256", "planTaskCount", "candidateSealRequired", "reviewSeparationRequired", "handoffRequired"],
      "properties": {
        "planPath": {"type": "string", "minLength": 1},
        "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "planTaskCount": {"type": "integer", "minimum": 1},
        "candidateSealRequired": {"const": true},
        "reviewSeparationRequired": {"const": true},
        "handoffRequired": {"const": true}
      }
    },
    "stopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTotalSeconds", "maxJobSeconds", "maxContextFiles", "maxTranscriptBytes", "maxRepairRounds", "conditions"],
      "properties": {
        "maxTotalSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maxJobSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maxContextFiles": {"type": "integer", "minimum": 1},
        "maxTranscriptBytes": {"type": "integer", "minimum": 1},
        "maxRepairRounds": {"type": "integer", "minimum": 1},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "revisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialRevision", "nextRevisionPattern", "repairRequiresDerivedRebuild", "packageRebindsFinalSeal", "staleEvidenceForbidden"],
      "properties": {
        "initialRevision": {"type": "string", "pattern": "^r[0-9]+$"},
        "nextRevisionPattern": {"type": "string", "minLength": 1},
        "repairRequiresDerivedRebuild": {"const": true},
        "packageRebindsFinalSeal": {"const": true},
        "staleEvidenceForbidden": {"const": true}
      }
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "condition", "required", "sourceRef"],
        "properties": {
          "criterionId": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "sourceRef": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subgoals", "requiredSubgoals", "guardrailRules", "toolRoutes", "readScopeCount", "exitCriteria"],
      "properties": {
        "subgoals": {"type": "integer", "minimum": 1},
        "requiredSubgoals": {"type": "integer", "minimum": 1},
        "guardrailRules": {"type": "integer", "minimum": 0},
        "toolRoutes": {"type": "integer", "minimum": 1},
        "readScopeCount": {"type": "integer", "minimum": 0},
        "exitCriteria": {"type": "integer", "minimum": 1}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
